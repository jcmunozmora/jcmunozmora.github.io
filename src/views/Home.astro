---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { photos } from '../data/photos';
import PublicationItem from '../components/PublicationItem.astro';
import ActivityCard from '../components/ActivityCard.astro';
import portrait from '../assets/img/prof_pic.jpg';
import { routes, SITE, t, type Lang } from '../i18n/ui';
import { getActivity } from '../lib/activity';
import { workingPapers } from '../lib/cv';
import WorkingPaperItem from '../components/WorkingPaperItem.astro';
import TopicChips from '../components/TopicChips.astro';
import { personJsonLd } from '../lib/seo';
import Counters from '../components/Counters.astro';
import OrgChooser from '../components/OrgChooser.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const selected = (await getCollection('publications'))
  .filter((p) => p.data.selected)
  .sort((a, b) => b.data.year - a.data.year);
const recent = (await getActivity()).slice(0, 3);
const allPubTitles = (await getCollection('publications')).map((p) => p.data.title);
const latestWps = workingPapers(lang, allPubTitles).filter((p) => p.status === 'ssrn').slice(0, 4);
---

<Base lang={lang} route="home" jsonLd={personJsonLd(Astro.site!, tr('meta.description'))}>
  <section class="hero">
    <div class="topo-wrap"><Topo /></div>
    <div class="container hero-grid">
      <div class="fade-in">
        <p class="eyebrow">{tr('hero.role')}</p>
        <h1>{SITE.name}</h1>
        <p class="tagline">{tr('hero.tagline')}</p>
        <p class="bio">{tr('hero.bio')}</p>
        <div class="ctas">
          <a class="btn primary" href={routes.research[lang]}>{tr('hero.cta.research')}</a>
          <a class="btn" href={`mailto:${SITE.email}`}>{tr('hero.cta.contact')}</a>
        </div>
      </div>
      <figure class="portrait fade-in">
        <Image
          src={portrait}
          alt={SITE.name}
          width={440}
          widths={[220, 330, 440, 660]}
          sizes="(max-width: 860px) 40vw, 300px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <Counters lang={lang} />

  <section class="section container no-rule">
    <p class="eyebrow">{tr('pillars.eyebrow')}</p>
    <div class="pillars">
      {[
        { cls: 'territory', photo: photos.colinas, title: tr('pillars.territory.title'), body: tr('pillars.territory.body') },
        { cls: 'method', photo: photos.parcelas, title: tr('pillars.method.title'), body: tr('pillars.method.body') },
      ].map((p) => (
        <article class:list={['pillar', p.cls]}>
          <Image src={p.photo.src} alt="" widths={[480, 720, 960]} sizes="(max-width: 860px) 92vw, 560px" loading="lazy" style={p.photo.focus ? `object-position:${p.photo.focus}` : undefined} />
          <div class="pillar-body">
            <h2>{p.title}</h2>
            <p>{p.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="organizations" class="section container">
    <p class="eyebrow">{tr('orgs.eyebrow')}</p>
    <h2>{tr('orgs.title')}</h2>
    <p class="lede-sm">{tr('orgs.lede')}</p>
    <OrgChooser lang={lang} />
  </section>

  <section class="section container edge">
    <p class="eyebrow">{tr('edge.eyebrow')}</p>
    <h2>{tr('edge.title')}</h2>
    <p class="lede-sm">{tr('edge.lede')}</p>
    <ol class="steps">
      {(['s1', 's2', 's3'] as const).map((k, i) => (
        <li>
          <span class="step num">0{i + 1}</span>
          <h3>{tr(`edge.${k}.k`)}</h3>
          <p>{tr(`edge.${k}.body`)}</p>
        </li>
      ))}
    </ol>
    <p><a class="more" href={routes.projects[lang]}>{tr('edge.cta')} →</a></p>
  </section>

  <PhotoBand photo={photos.valle} lang={lang} quote={tr('pillars.both')} />

  <section class="section container no-rule">
    <div class="section-head">
      <h2>{tr('topics.explore')}</h2>
      <a class="more" href={routes.topics[lang]}>{tr('topics.all')} →</a>
    </div>
    <TopicChips lang={lang} />
  </section>

  {selected.length > 0 && (
    <section class="section container no-rule">
      <div class="section-head">
        <h2>{tr('home.selected')}</h2>
        <a class="more" href={routes.research[lang]}>{tr('home.allPubs')} →</a>
      </div>
      <div class="prose-wide">
        {selected.map((p) => <PublicationItem pub={p} lang={lang} showYear />)}
      </div>
    </section>
  )}

  {latestWps.length > 0 && (
    <section class="section container">
      <div class="section-head">
        <h2>{tr('home.working')}</h2>
        <a class="more" href={`${routes.research[lang]}#working`}>{tr('home.allWorking')} →</a>
      </div>
      <div class="prose-wide">{latestWps.map((p) => <WorkingPaperItem paper={p} lang={lang} />)}</div>
    </section>
  )}

  {recent.length > 0 && (
    <section class="section container">
      <div class="section-head">
        <h2>{tr('home.activity')}</h2>
        <a class="more" href={routes.activity[lang]}>{tr('home.allActivity')} →</a>
      </div>
      <div class="cards">
        {recent.map((post) => <ActivityCard post={post} lang={lang} compact />)}
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .topo-wrap {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, #000 55%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 55%);
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18.75rem;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  h1 { margin-bottom: 0.25em; }
  .tagline {
    font-size: var(--step-1);
    font-weight: 550;
    color: var(--link);
    margin-bottom: 1.25rem;
  }
  .bio { max-width: 38rem; font-size: 1.08rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius);
    border: 1px solid var(--heading);
    color: var(--heading);
    font-weight: 550;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .btn:hover { background: var(--heading); color: var(--bg); }
  .btn.primary { background: var(--teal); border-color: var(--teal); color: #fff; }
  .btn.primary:hover { background: #0a5c5f; border-color: #0a5c5f; }
  .portrait { margin: 0; }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    filter: saturate(0.9);
  }

  .pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .pillar {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .pillar :global(img) { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; filter: saturate(0.85); border-bottom: 3px solid; }
  .pillar.territory :global(img) { border-bottom-color: var(--territory); }
  .pillar.method :global(img) { border-bottom-color: var(--method); }
  .pillar-body { padding: 1.5rem 1.75rem 1.75rem; }
  .pillar h2 { font-size: var(--step-1); }
  .pillar p { margin: 0; }

  .prose-wide { max-width: 56rem; }
  .lede-sm { max-width: var(--measure); margin-bottom: 1.75rem; }
  .edge h2 { max-width: 44rem; }
  .steps { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; counter-reset: s; }
  .steps li { position: relative; padding: 1.4rem 1.5rem 1.5rem; border: 1px solid var(--border); background: var(--card); }
  .steps li + li { border-left: 0; }
  .steps li:first-child { border-radius: var(--radius) 0 0 var(--radius); }
  .steps li:last-child { border-radius: 0 var(--radius) var(--radius) 0; border-top: 3px solid var(--method); }
  .steps li:not(:last-child)::after { content: '→'; position: absolute; right: -0.7rem; top: 1.3rem; z-index: 1; background: var(--bg); color: var(--method); font-weight: 600; padding: 0 0.15rem; }
  .step { display: block; font-size: 0.78rem; color: var(--method); margin-bottom: 0.5rem; }
  .steps h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
  .steps p { margin: 0; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; }
    .steps li + li { border-left: 1px solid var(--border); border-top: 0; }
    .steps li:first-child { border-radius: var(--radius) var(--radius) 0 0; }
    .steps li:last-child { border-radius: 0 0 var(--radius) var(--radius); border-top: 0; border-bottom: 3px solid var(--method); }
    .steps li:not(:last-child)::after { content: '↓'; right: auto; left: 1.5rem; top: auto; bottom: -0.8rem; }
  }
  .no-rule { border-top: 0 !important; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .portrait { order: -1; width: min(11rem, 45vw); }
    .portrait :global(img) { aspect-ratio: 1; border-radius: 50%; }
    .topo-wrap { mask-image: linear-gradient(to bottom, #000, transparent 70%); -webkit-mask-image: linear-gradient(to bottom, #000, transparent 70%); }
    .pillars, .cards { grid-template-columns: 1fr; }
  }
</style>
