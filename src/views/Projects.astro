---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { photos } from '../data/photos';
import { featured } from '../data/projects';
import { t, type Lang } from '../i18n/ui';
import { siteProjects, type SiteProject } from '../lib/projects';
import { MODES, PARTNERS, counters } from '../lib/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const all = siteProjects(lang);
const groups: { id: string; title: string; items: SiteProject[] }[] = [
  { id: 'current', title: tr('projects.current'), items: all.filter((p) => p.current) },
  { id: 'grants', title: tr('projects.completed'), items: all.filter((p) => !p.current) },
];
const c = counters();
---

<Base lang={lang} route="projects" title={tr('projects.title')} description={tr('projects.lede')}>
  <header class="container page-head">
    <p class="eyebrow">{tr('nav.projects')}</p>
    <h1>{tr('projects.title')}</h1>
    <p class="lede">{tr('projects.lede')}</p>
  </header>

  <PhotoBand photo={photos.niebla} lang={lang} height="clamp(9rem, 20vw, 16rem)" />

  <section class="section container">
    <article class="featured">
      <div>
        <p class="eyebrow">{tr('projects.featured')}</p>
        <h2>{featured.title[lang]}</h2>
        <p class="partner">{featured.partner[lang]}</p>
        {featured.body?.[lang].map((para) => <p>{para}</p>)}
        <p class="outs">
          <a class="tag" href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6399298" target="_blank" rel="noopener">{lang === 'es' ? 'Documento de trabajo: evaluación de impacto' : 'Working paper: impact evaluation'}</a>
          <a class="tag" href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5387296" target="_blank" rel="noopener">{lang === 'es' ? 'Documento de trabajo: vivienda y bienestar' : 'Working paper: housing and well-being'}</a>
        </p>
      </div>
      <figure>
        <Image src={photos.medellin.src} alt={photos.medellin.alt[lang]} width={620} widths={[320, 520, 780]} sizes="(max-width: 860px) 90vw, 420px" loading="lazy" style={`object-position:${photos.medellin.focus ?? 'center'}`} />
        <figcaption class="credit">{photos.medellin.place} · <a href={photos.medellin.url} target="_blank" rel="noopener">{photos.medellin.author}</a> / Unsplash</figcaption>
      </figure>
    </article>
  </section>

  <div class="pwrap">
    <section class="section container filters" aria-label={tr('projects.filter')}>
      <fieldset>
        <legend class="eyebrow">{tr('projects.filter')}</legend>
        <label><input type="radio" name="mode" id="m-all" value="all" checked /><span>{tr('projects.all')} <span class="num">{all.length}</span></span></label>
        {MODES.map((m) => (
          <label><input type="radio" name="mode" id={`m-${m}`} value={m} /><span><i class:list={['dot', `d-${m}`]} />{tr(`mode.${m}`)} <span class="num">{c.byMode[m]}</span></span></label>
        ))}
      </fieldset>
      <fieldset>
        <legend class="eyebrow">{tr('orgs.eyebrow')}</legend>
        <label><input type="radio" name="org" id="org-all" value="all" checked /><span>{tr('projects.all')}</span></label>
        {PARTNERS.map((p) => (
          <label><input type="radio" name="org" id={`org-${p}`} value={p} /><span>{tr(`partner.${p}`)} <span class="num">{c.byPartner[p]}</span></span></label>
        ))}
      </fieldset>
    </section>

    {groups.map((g) => (
      <section id={g.id} class="section container">
        <h2>{g.title} <span class="count num">{g.items.length}</span></h2>
        <ul class="plist">
          {g.items.map((p) => (
            <li data-modes={p.modes.join(' ')} data-org={p.partner}>
              <span class="when num">{p.when}</span>
              <div>
                <p class="who">{p.funder && <strong set:html={p.funder} />}{p.funder && p.role && ' · '}{p.role && <span class="role" set:html={p.role} />}</p>
                <p class="what" set:html={p.description} />
                <p class="kinds">
                  {p.modes.map((m) => <span class="kind"><i class:list={['dot', `d-${m}`]} />{tr(`mode.${m}`)}</span>)}
                  {p.partner && <span class="kind org">{tr(`partner.${p.partner}`)}</span>}
                </p>
                {p.outputs.length > 0 && (
                  <p class="outs">
                    {p.outputs.map((o) => (
                      <a class="tag" href={o.href} target={o.external ? '_blank' : undefined} rel={o.external ? 'noopener' : undefined}>{o.label[lang]}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <script is:inline>
    (() => {
      const pick = () => {
        const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el && el.matches('.filters input')) { el.checked = true; el.closest('.filters').scrollIntoView({ block: 'start' }); }
      };
      pick();
      addEventListener('hashchange', pick);
    })();
  </script>
</Base>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24rem;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .partner { color: var(--muted); font-size: 0.95rem; }
  figure { margin: 0; }
  figure :global(img) { border-radius: var(--radius); border: 1px solid var(--border); aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .credit { font-family: var(--font-mono); font-size: 0.68rem; color: var(--muted); margin-top: 0.4rem; }
  .credit a { color: inherit; }
  .count { font-size: 0.85rem; color: var(--muted); font-weight: 500; margin-left: 0.35rem; }
  .plist { list-style: none; margin: 0; padding: 0; max-width: 62rem; }
  .plist li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1.25rem; padding-block: 1rem; border-top: 1px solid var(--border); }
  .when { font-size: 0.82rem; color: var(--muted); padding-top: 0.2rem; }
  .who { margin: 0 0 0.2rem; font-size: 0.92rem; color: var(--muted); }
  .who strong { color: var(--heading); font-weight: 600; }
  .role :global(em) { font-style: normal; }
  .what { margin: 0; font-size: 0.97rem; color: var(--text); }
  .what :global(em) { font-style: italic; }
  .filters { display: grid; gap: 1rem; scroll-margin-top: 5rem; }
  fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; }
  legend { float: left; width: 100%; margin-bottom: 0.4rem; }
  fieldset label { cursor: pointer; }
  fieldset input { position: absolute; opacity: 0; pointer-events: none; }
  fieldset label > span { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.45rem 0.85rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.88rem; font-weight: 550; color: var(--heading); background: var(--bg); }
  fieldset label > span .num { font-size: 0.72rem; opacity: 0.65; }
  fieldset label:hover > span { border-color: var(--link); }
  fieldset input:checked + span { background: var(--heading); border-color: var(--heading); color: var(--bg); }
  fieldset input:focus-visible + span { outline: 2px solid var(--link); outline-offset: 2px; }
  .d-research { color: var(--heading); }
  .d-evaluation { color: var(--method); }
  .d-policy { color: var(--territory); }
  .d-advisory { color: #b7791f; }
  input:checked + span .dot { color: var(--bg); }
  .kinds { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; margin: 0.55rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .kind { display: inline-flex; align-items: center; gap: 0.35rem; }
  .kind.org { font-family: var(--font-mono); font-size: 0.72rem; }
  .pwrap:has(#m-research:checked) .plist li:not([data-modes~='research']),
  .pwrap:has(#m-evaluation:checked) .plist li:not([data-modes~='evaluation']),
  .pwrap:has(#m-policy:checked) .plist li:not([data-modes~='policy']),
  .pwrap:has(#m-advisory:checked) .plist li:not([data-modes~='advisory']),
  .pwrap:has(#org-public:checked) .plist li:not([data-org='public']),
  .pwrap:has(#org-funds:checked) .plist li:not([data-org='funds']),
  .pwrap:has(#org-private:checked) .plist li:not([data-org='private']),
  .pwrap:has(#org-academia:checked) .plist li:not([data-org='academia']) { display: none; }
  .pwrap:has(.filters input:not([value='all']):checked) .count { display: none; }
  .outs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.6rem 0 0; }

  @media (max-width: 860px) { .featured { grid-template-columns: 1fr; } figure { max-width: 26rem; } }
  @media (max-width: 600px) { .plist li { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
