---
import { topicBySlug, topics } from '../data/topics';
import { routes, type Lang } from '../i18n/ui';

interface Props { lang: Lang; slugs?: string[]; counts?: Record<string, number>; current?: string }
const { lang, slugs, counts, current } = Astro.props;
const list = (slugs ?? topics.map((t) => t.slug)).map((s) => topicBySlug[s]).filter(Boolean);
const base = routes.topics[lang];
---

<ul class="chips">
  {list.map((t) => (
    <li>
      <a
        class:list={['chip', t.pillar === 'method' ? 'pillar-method' : 'pillar-territory']}
        href={`${base}${t.slug}/`}
        aria-current={current === t.slug ? 'page' : undefined}
      >
        <span class="dot"></span><span class="label">{t[lang]}</span>{counts && <span class="n num">{counts[t.slug] ?? 0}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .chip .label { color: var(--heading); }
  .chip:hover { border-color: currentColor; }
  .chip[aria-current='page'] { border-color: currentColor; background: var(--bg); box-shadow: inset 0 0 0 1px currentColor; }
  .n { font-size: 0.72rem; color: var(--muted); }
</style>
