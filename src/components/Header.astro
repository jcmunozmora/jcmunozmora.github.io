---
import { SITE, routes, t, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  current?: RouteKey;
}
const { lang, alternates, current } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = alternates[other] ?? routes.home[other];

const items: { key: RouteKey; label: string }[] = [
  { key: 'research', label: tr('nav.research') },
  { key: 'projects', label: tr('nav.projects') },
  { key: 'teaching', label: tr('nav.teaching') },
  { key: 'activity', label: tr('nav.activity') },
];
const path = Astro.url.pathname;
const isCurrent = (key: RouteKey) => current === key || (key === 'activity' && path.startsWith(routes.activity[lang]));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={routes.home[lang]}>
      <span class="mark" aria-hidden="true">JCM</span>
      <span class="name">{SITE.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {items.map((i) => (
          <li><a href={routes[i.key][lang]} aria-current={isCurrent(i.key) ? 'page' : undefined}>{i.label}</a></li>
        ))}
        <li><a href={SITE.slides}>{tr('nav.talks')}</a></li>
      </ul>
    </nav>
    <div class="tools">
      <a class="lang" href={otherHref} hreflang={other} lang={other} title={tr('lang.switch')}>
        {other.toUpperCase()}<span class="visually-hidden"> · {tr('lang.switch')}</span>
      </a>
      <button class="theme" type="button" aria-label={tr('theme.toggle')} data-theme-toggle>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--heading);
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .mark {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--navy);
    border-radius: 4px;
    padding: 0.35rem 0.4rem;
    line-height: 1;
  }
  :global([data-theme='dark']) .mark { background: var(--teal); }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  nav a:hover { color: var(--heading); background: var(--card); }
  nav a[aria-current='page'] { color: var(--heading); box-shadow: inset 0 -2px 0 var(--link); border-radius: 0; }
  .tools { display: flex; align-items: center; gap: 0.25rem; }
  .lang, .theme {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font: 500 0.75rem/1 var(--font-mono);
    text-decoration: none;
    cursor: pointer;
  }
  .lang:hover, .theme:hover { color: var(--heading); border-color: var(--muted); }
  .moon { display: none; }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='dark']) .moon { display: block; }

  @media (max-width: 860px) {
    .bar { flex-wrap: wrap; gap: 0 1rem; padding-top: 0.5rem; }
    nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; }
    nav ul { gap: 0; padding-bottom: 0.25rem; }
    nav a { padding: 0.5rem 0.6rem; white-space: nowrap; }
  }
  @media (max-width: 420px) {
    .name { font-size: 0.95rem; }
  }
</style>
