---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/img/prof_pic.jpg';
import { SITE, t, dateFmt, type Lang } from '../i18n/ui';
import { cvUpdated, dated, inline, sectionTitle, text, type SectionKey } from '../lib/cv';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const cvPdf = lang === 'es' ? '/cv/CV-MunozMora-ES.pdf' : '/cv/CV-MunozMora-EN.pdf';

const timeline: SectionKey[] = ['appointments', 'leadership', 'education', 'affiliations', 'honors', 'earlier_positions'];
const fields = inline('fields', lang);
const refereeing = inline('refereeing', lang);
const skills = dated('skills', lang);
---

<Base lang={lang} route="about" title={tr('about.title')} description={tr('about.lede')}>
  <header class="container page-head about-head">
    <div>
      <p class="eyebrow">{tr('nav.about')}</p>
      <h1>{SITE.name}</h1>
      <p class="lede">{tr('about.lede')}</p>
      <div class="profile" set:html={text('profile', lang)} />
      <p class="actions">
        <a class="btn primary" href={cvPdf}>{tr('about.cv')}</a>
        <span class="updated">{tr('about.updated')} <time class="num" datetime={cvUpdated}>{dateFmt(lang, new Date(cvUpdated), { year: 'numeric', month: 'long' })}</time></span>
      </p>
    </div>
    <figure>
      <Image src={portrait} alt={SITE.name} width={360} widths={[240, 360, 540]} sizes="(max-width: 860px) 40vw, 260px" />
    </figure>
  </header>

  <section class="section container">
    <h2>{tr('about.fields')}</h2>
    <ul class="chips">{fields.map((f) => <li class="tag">{f}</li>)}</ul>
  </section>

  <section class="section container grid">
    {timeline.map((key) => (
      <div class="block">
        <h2>{sectionTitle(key, lang)}</h2>
        <ul class="rows">
          {dated(key, lang).map((r) => <li><span class="when num">{r.when}</span><span set:html={r.text} /></li>)}
        </ul>
      </div>
    ))}
  </section>

  <section class="section container grid">
    <div class="block">
      <h2>{sectionTitle('refereeing', lang)}</h2>
      <ul class="chips">{refereeing.map((f) => <li class="tag">{f}</li>)}</ul>
    </div>
    <div class="block">
      <h2>{sectionTitle('skills', lang)}</h2>
      <ul class="rows">{skills.map((r) => <li><span class="when">{r.when}</span><span set:html={r.text} /></li>)}</ul>
    </div>
  </section>
</Base>

<style>
  .about-head { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .profile { max-width: var(--measure); font-size: 1.02rem; }
  .profile :global(strong) { color: var(--heading); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.25rem; margin-top: 1.5rem; }
  .btn {
    display: inline-flex;
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius);
    background: var(--teal);
    color: #fff;
    font-weight: 550;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .btn:hover { background: #0a5c5f; }
  .updated { font-size: 0.85rem; color: var(--muted); }
  figure { margin: 0; }
  figure :global(img) { border-radius: var(--radius); border: 1px solid var(--border); aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
  .chips .tag { font-size: 0.8rem; padding: 0.45em 0.7em; color: var(--text); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem clamp(2rem, 5vw, 4rem); }
  .block h2 { font-size: var(--step-1); }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding-block: 0.7rem; border-top: 1px solid var(--border); font-size: 0.95rem; }
  .rows :global(strong) { color: var(--heading); font-weight: 600; }
  .rows :global(em) { font-style: normal; }
  .when { font-size: 0.8rem; color: var(--muted); padding-top: 0.15rem; }
  @media (max-width: 860px) {
    .about-head { grid-template-columns: 1fr; }
    figure { order: -1; width: min(10rem, 40vw); }
    figure :global(img) { aspect-ratio: 1; border-radius: 50%; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
