---
import type { WorkingPaper } from '../lib/cv';
import { t, type Lang } from '../i18n/ui';
import { codeFor } from '../data/resources';
import abstracts from '../data/abstracts.json';
import { titleSlug } from '../lib/slug';

interface Props { paper: WorkingPaper; lang: Lang }
const { paper, lang } = Astro.props;
const tr = t(lang);
const code = codeFor(paper.title);
const abstract = (abstracts as Record<string, { abstract: string }>)[titleSlug(paper.title)]?.abstract;
const ext = { target: '_blank', rel: 'noopener' };
const badge = paper.status === 'ssrn' ? `SSRN ${paper.ssrn}` : tr(`status.${paper.status}` as 'status.ssrn');
---

<article class="wp">
  <div class="meta">
    <span class:list={['tag', { ssrn: paper.status === 'ssrn' }]}>{badge}</span>
  </div>
  <div>
    <h3>{paper.href ? <a href={paper.href} {...ext}>{paper.title}</a> : paper.title}</h3>
    <p class="detail" set:html={paper.detail} />
    {(code || abstract) && (
      <div class="actions">
        {code && <a class="tag" href={code} {...ext}>{tr('pub.code')}</a>}
        {abstract && (
          <details>
            <summary class="tag">{tr('pub.abstract')}</summary>
            <p class="abstract">{abstract}</p>
          </details>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .wp {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.25rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .meta { padding-top: 0.2rem; }
  .tag.ssrn { color: var(--link); border-color: color-mix(in srgb, var(--link) 45%, var(--border)); }
  h3 { font-size: 1.02rem; font-weight: 600; line-height: 1.4; margin: 0 0 0.3rem; }
  h3 a { color: var(--heading); text-decoration: none; }
  h3 a:hover { color: var(--link); text-decoration: underline; }
  .detail { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .detail :global(em) { font-style: normal; color: var(--text); }
  .detail :global(a) { display: none; }
  .actions { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0.5rem; margin-top: 0.6rem; }
  details { display: contents; }
  summary { cursor: pointer; list-style: none; color: var(--link); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: 0.25rem; }
  details[open] summary::after { content: '−'; }
  .abstract { flex-basis: 100%; margin: 0.35rem 0 0; padding: 1rem 1.1rem; background: var(--card); border-left: 2px solid var(--method); border-radius: 0 var(--radius) var(--radius) 0; font-size: 0.93rem; line-height: 1.65; color: var(--text); }
  @media (max-width: 560px) { .wp { grid-template-columns: 1fr; gap: 0.4rem; } }
</style>
