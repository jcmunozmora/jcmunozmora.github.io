---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, t, type Lang, type RouteKey, routes } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  route?: RouteKey;
  // For pages without a parallel translation (e.g. a single post), the path of each language version.
  alternates?: Partial<Record<Lang, string>>;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  canonicalPath?: string;
}

const { lang, title, description, route, alternates, type = 'website', jsonLd, canonicalPath } = Astro.props;
const tr = t(lang);
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${tr('hero.tagline')}`;
const desc = description ?? tr('meta.description');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const alt: Partial<Record<Lang, string>> = alternates ?? (route ? routes[route] : {});
const ogImage = new URL('/og/default.png', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alt).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p!, Astro.site)} />)}
    {alt.en && <link rel="alternate" hreflang="x-default" href={new URL(alt.en, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${tr('activity.title')}`} href={lang === 'es' ? '/es/rss.xml' : '/rss.xml'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#1B2A4A" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jcmunozmora" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{tr('nav.skip')}</a>
    <Header lang={lang} alternates={alt} current={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
