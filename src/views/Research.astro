---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PublicationItem from '../components/PublicationItem.astro';
import WorkCard from '../components/WorkCard.astro';
import WorkingPaperItem from '../components/WorkingPaperItem.astro';
import { photos } from '../data/photos';
import { works } from '../data/works';
import { SSRN_AUTHOR_PAGE } from '../data/ssrn';
import { SITE, t, type Lang } from '../i18n/ui';
import { notionPapersInProgress, workingPapers } from '../lib/cv';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
const years = [...new Set(pubs.map((p) => p.data.year))];
const byYear = (kind: string) => works.filter((w) => w.kind === kind).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const books = byYear('book');
const chapters = byYear('chapter');
const policy = byYear('policy');
const wps = workingPapers(lang, pubs.map((p) => p.data.title));
const wip = notionPapersInProgress([...pubs.map((p) => p.data.title), ...works.map((w) => w.title)]);

const jump = [
  { id: 'working', label: tr('research.working'), n: wps.length },
  { id: 'articles', label: tr('research.articles'), n: pubs.length },
  { id: 'books', label: tr('research.books'), n: books.length + chapters.length },
  { id: 'policy', label: tr('research.policy'), n: policy.length },
];
---

<Base lang={lang} route="research" title={tr('research.title')} description={tr('research.lede')}>
  <header class="container page-head">
    <p class="eyebrow">{tr('nav.research')}</p>
    <h1>{tr('research.title')}</h1>
    <p class="lede">{tr('research.lede')}</p>
    <nav class="jump" aria-label={tr('research.title')}>
      {jump.map((j) => <a href={`#${j.id}`}>{j.label} <span class="num">{j.n}</span></a>)}
      <a href={SITE.scholar} rel="noopener">Google Scholar ↗</a>
      <a href={SSRN_AUTHOR_PAGE} rel="noopener">SSRN ↗</a>
    </nav>
  </header>

  <PhotoBand photo={photos.mosaico} lang={lang} height="clamp(9rem, 20vw, 16rem)" />

  <section id="working" class="section container">
    <div class="section-head">
      <h2>{tr('research.working')}</h2>
      <a class="more" href={SSRN_AUTHOR_PAGE} rel="noopener">{tr('research.ssrnAll')} ↗</a>
    </div>
    <div class="list">{wps.map((p) => <WorkingPaperItem paper={p} lang={lang} />)}</div>
  </section>

  <section id="articles" class="section container">
    <h2>{tr('research.articles')}</h2>
    {years.map((y) => (
      <div class="year-group">
        <h3 class="year num">{y}</h3>
        <div>{pubs.filter((p) => p.data.year === y).map((p) => <PublicationItem pub={p} lang={lang} />)}</div>
      </div>
    ))}
  </section>

  <section id="books" class="section container">
    <h2>{tr('research.books')}</h2>
    <div class="list">{books.map((w) => <WorkCard work={w} lang={lang} />)}</div>
    <h3 class="sub">{tr('research.chapters')}</h3>
    <div class="list">{chapters.map((w) => <WorkCard work={w} lang={lang} />)}</div>
  </section>

  <section id="policy" class="section container">
    <h2>{tr('research.policy')}</h2>
    <div class="list">{policy.map((w) => <WorkCard work={w} lang={lang} />)}</div>
  </section>

  {wip.length > 0 && (
    <section id="wip" class="section container">
      <h2>{tr('research.wip')}</h2>
      <ul class="wip">
        {wip.map((p) => (
          <li>
            <span class="tag">{tr(`status.${p.status}` as 'status.in_progress')}</span>
            <span>{p.title}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.5rem; font-size: 0.93rem; }
  .jump a { text-decoration: none; font-weight: 500; }
  .jump .num { color: var(--muted); font-size: 0.8rem; margin-left: 0.2rem; }
  .list { max-width: 62rem; }
  .sub { margin-top: 2.5rem; font-size: 1.1rem; }
  .year-group {
    display: grid;
    grid-template-columns: 6rem minmax(0, 56rem);
    gap: 1rem;
  }
  .year {
    position: sticky;
    top: 5rem;
    align-self: start;
    margin: 0;
    padding-top: 1.35rem;
    font-size: 1rem;
    color: var(--heading);
  }
  .wip { list-style: none; margin: 0; padding: 0; max-width: 62rem; }
  .wip li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 0.8rem;
    border-top: 1px solid var(--border);
    font-size: 0.97rem;
    color: var(--heading);
  }
  .wip .tag { justify-self: start; }
  @media (max-width: 720px) {
    .year-group { grid-template-columns: 1fr; gap: 0; }
    .year { position: static; padding-top: 1.5rem; }
    .wip li { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
