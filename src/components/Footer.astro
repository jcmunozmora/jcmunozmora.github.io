---
import { SITE, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
const links = [
  { label: 'LinkedIn', href: SITE.linkedin },
  { label: 'ORCID', href: `https://orcid.org/${SITE.orcid}` },
  { label: 'GitHub', href: SITE.github },
  { label: 'ResearchGate', href: SITE.researchgate },
  { label: 'X', href: SITE.x },
];
---

<footer class="site-footer" id="contact">
  <div class="container grid">
    <div>
      <p class="eyebrow">{tr('footer.contact')}</p>
      <p class="who">{SITE.name}</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="muted">Universidad EAFIT · Medellín, Colombia</p>
    </div>
    <div>
      <p class="eyebrow">{tr('footer.elsewhere')}</p>
      <ul>
        {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
      </ul>
    </div>
    <div class="fine">
      <p class="tagline">{tr('hero.tagline')}</p>
      <p class="muted"><span class="num">© {year}</span> - {SITE.name}</p>
      <p class="muted">ORCID <span class="num">{SITE.orcid}</span></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: 3rem;
    background: var(--navy);
    color: #cbd5e0;
  }
  :global([data-theme='dark']) .site-footer { background: #0a1020; border-top: 1px solid var(--border); }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.4fr;
    gap: 2rem;
  }
  .eyebrow { color: #94a3b8; }
  p { margin: 0 0 0.35rem; font-size: 0.95rem; }
  .who { color: #fff; font-weight: 600; }
  a { color: #fff; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; font-size: 0.95rem; }
  .tagline { color: #fff; font-weight: 550; font-size: 1.05rem; margin-bottom: 0.75rem; }
  .muted { color: #94a3b8; font-size: 0.85rem; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
