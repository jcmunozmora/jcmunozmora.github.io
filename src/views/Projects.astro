---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { photos } from '../data/photos';
import { featured, repos } from '../data/projects';
import { t, dateFmt, type Lang } from '../i18n/ui';
import { dated, notionCurrentProjects } from '../lib/cv';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const current = notionCurrentProjects();
const grants = dated('grants', lang);
const pillar = { territory: 'pillar-territory', method: 'pillar-method', both: 'pillar-both' } as const;
---

<Base lang={lang} route="projects" title={tr('projects.title')} description={tr('projects.lede')}>
  <header class="container page-head">
    <p class="eyebrow">{tr('nav.projects')}</p>
    <h1>{tr('projects.title')}</h1>
    <p class="lede">{tr('projects.lede')}</p>
  </header>

  <PhotoBand photo={photos.niebla} lang={lang} height="clamp(9rem, 20vw, 16rem)" />

  <section class="section container">
    <article class="featured">
      <div>
        <p class="eyebrow">{tr('projects.featured')}</p>
        <h2>{featured.title[lang]}</h2>
        <p class="partner">{featured.partner[lang]}</p>
        {featured.body?.[lang].map((para) => <p>{para}</p>)}
        {featured.pdf && <p><a class="tag" href={featured.pdf}>{lang === 'es' ? 'Informe final (PDF)' : 'Final report (PDF, Spanish)'}</a></p>}
      </div>
      {featured.image && (
        <figure>
          <Image src={featured.image} alt="" width={520} widths={[320, 520, 780]} sizes="(max-width: 860px) 90vw, 420px" loading="lazy" />
        </figure>
      )}
    </article>
  </section>

  {current.length > 0 && (
    <section class="section container">
      <h2>{tr('projects.current')}</h2>
      <ul class="current">
        {current.map((p) => (
          <li>
            <span class="when num">{p.dates?.start ? dateFmt(lang, new Date(p.dates.start), { year: 'numeric', month: 'short' }) : ''}{p.dates?.end ? ` – ${dateFmt(lang, new Date(p.dates.end), { year: 'numeric', month: 'short' })}` : ''}</span>
            <span class="what">{p.title}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="grants" class="section container">
    <h2>{tr('projects.grants')}</h2>
    <ul class="grants">
      {grants.map((g) => (
        <li><span class="when num">{g.when}</span><span class="what" set:html={g.text} /></li>
      ))}
    </ul>
  </section>

  <section class="section container">
    <h2>{tr('projects.repos')}</h2>
    <div class="repos">
      {repos.map((r) => (
        <a class="repo" href={r.href}>
          <span class:list={['tag', pillar[r.pillar]]}><span class="dot"></span>{r.partner[lang]}</span>
          <h3>{r.title[lang]}</h3>
          <p>{r.summary[lang]}</p>
          <span class="go">{tr('projects.visit')} →</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24rem;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .partner { color: var(--muted); font-size: 0.95rem; }
  figure { margin: 0; }
  figure :global(img) { border-radius: var(--radius); border: 1px solid var(--border); }
  .repos { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1rem; }
  .repo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .repo:hover { border-color: var(--link); }
  .repo .tag { white-space: normal; text-align: left; line-height: 1.3; }
  .repo h3 { font-size: 1.05rem; margin: 0; }
  .repo p { margin: 0; font-size: 0.93rem; flex: 1; }
  .go { font-size: 0.88rem; font-weight: 550; color: var(--link); }
  .current, .grants { list-style: none; margin: 0; padding: 0; max-width: 62rem; }
  .current li, .grants li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.25rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--border);
    font-size: 0.97rem;
  }
  .when { font-size: 0.82rem; color: var(--muted); padding-top: 0.15rem; }
  .what { color: var(--text); }
  .current .what { color: var(--heading); font-weight: 550; }
  .grants .what :global(strong) { color: var(--heading); font-weight: 600; }
  .grants .what :global(em) { font-style: normal; }
  @media (max-width: 600px) { .current li, .grants li { grid-template-columns: 1fr; gap: 0.2rem; } }
  @media (max-width: 860px) { .featured { grid-template-columns: 1fr; } figure { max-width: 26rem; } }
</style>
